# ═══════════════════════════════════════════════════════════════
# Plotrello — variables de entorno (copiar a .env.local, NUNCA commitear)
# ═══════════════════════════════════════════════════════════════

# ── Supabase (públicas en cliente — solo anon key) ──
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon
VITE_SUPABASE_SCHEMA=public

# ── Supabase SERVER (solo Vercel / scripts — SIN prefijo VITE_) ──
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...anon
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role

# ── IA (solo servidor — NO usar VITE_GEMINI_API_KEY en producción) ──
GEMINI_API_KEY=

# ── Seguridad endpoints admin ──
PLOT_LAB_BACKUP_TOKEN=generar-token-largo-aleatorio
NOTIFY_ORDEN_WEBHOOK_SECRET=generar-token-largo-aleatorio
PLOT_LAB_STAFF_JWT_SECRET=generar-token-largo-aleatorio-distinto
CRON_SECRET=
PLOT_LAB_ALLOWED_ORIGINS=https://trello.plotcenter.com.ar,https://plotrello.vercel.app

# ── Email / bots ──
RESEND_API_KEY=
EMAIL_FROM=Plot Center <noreply@plotcenter.com.ar>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USERS=

# ── AFIP / facturación electrónica (solo servidor — @afipsdk/afip.js) ──
# Token en https://app.afipsdk.com
AFIP_ACCESS_TOKEN=
# Homologación: CUIT de prueba AfipSDK (sin certificado). Producción: tu CUIT.
AFIP_CUIT=20409378472
AFIP_PRODUCTION=false
# Opcional: certificado propio (PEM, usar \n para saltos de línea)
# AFIP_CERT=
# AFIP_KEY=

# ── Desarrollo (no usar en producción) ──
# VITE_DEV_MOCK_AUTH=1
# VITE_DEV_LAN=1
# API Vercel desde SPA en Hostinger (si probás AFIP en local contra Vercel)
# VITE_PLOTLAB_API_ORIGIN=https://plotrello.vercel.app
