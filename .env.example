# ═══════════════════════════════════════════════════════════════
# Plot Lab — variables de entorno (copiar a .env.local, NUNCA commitear)
# Dominio producción: https://www.plotcenterlab.com.ar
# ═══════════════════════════════════════════════════════════════

# ── Supabase (públicas en cliente — solo anon key) ──
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon
VITE_SUPABASE_SCHEMA=public

# ── Supabase SERVER (solo Vercel / scripts — SIN prefijo VITE_) ──
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...anon
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role

# ── Dominio público Plot Lab (Vercel Production) ──
PLOT_LAB_PUBLIC_URL=https://www.plotcenterlab.com.ar
# CORS: se fusiona con los orígenes del código (plotcenterlab, trello, plotcenter, etc.)
PLOT_LAB_ALLOWED_ORIGINS=https://www.plotcenterlab.com.ar,https://plotcenterlab.com.ar,https://trello.plotcenter.com.ar,https://plotrello.vercel.app,https://plotcenter.com.ar,https://www.plotcenter.com.ar

# ── IA (solo servidor — NO usar VITE_GEMINI_API_KEY en producción) ──
GEMINI_API_KEY=

# ── Seguridad endpoints admin ──
PLOT_LAB_BACKUP_TOKEN=generar-token-largo-aleatorio
NOTIFY_ORDEN_WEBHOOK_SECRET=generar-token-largo-aleatorio
PLOT_LAB_STAFF_JWT_SECRET=generar-token-largo-aleatorio-distinto
CRON_SECRET=

# ── Email / bots ──
RESEND_API_KEY=
EMAIL_FROM=Plot Center <noreply@plotcenter.com.ar>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USERS=

# ── AFIP / facturación electrónica (solo servidor — @afipsdk/afip.js) ──
# Token en https://app.afipsdk.com
AFIP_ACCESS_TOKEN=
# Homologación: CUIT de prueba AfipSDK (sin certificado). Producción: tu CUIT.
AFIP_CUIT=20409378472
AFIP_PRODUCTION=false
# Opcional: certificado propio (PEM, usar \n para saltos de línea)
# AFIP_CERT=
# AFIP_KEY=

# ── Mercado Pago (solo servidor — Checkout Pro: venta, tótem, portal) ──
# Tus integraciones → tu app → Credenciales de prueba (sandbox) o producción.
# https://www.mercadopago.com.ar/developers/panel/app
# Scripts: node scripts/mp-onboard.mjs | scripts/mp-set-vercel-env.ps1
MERCADOPAGO_ACCESS_TOKEN=
# true = usa sandbox_init_point; quitar o false en producción real
# MERCADOPAGO_SANDBOX=true
MERCADOPAGO_WEBHOOK_URL=https://www.plotcenterlab.com.ar
# Webhooks (también van en notification_url de cada preference):
#   {WEBHOOK_URL}/api/mp/webhook
#   {WEBHOOK_URL}/api/totem/mp-webhook  (legacy tótem)

# ── Legacy PHP (solo si seguís usando API Hostinger) ──
# VITE_API_BASE_URL=https://trello.plotcenter.com.ar/api

# ── Dev local ──
# VITE_DEV_MOCK_AUTH=1
# VITE_DEV_LAN=1
# Solo si el SPA corre en Hostinger y las APIs en Vercel (caso legacy):
# VITE_PLOTLAB_API_ORIGIN=https://www.plotcenterlab.com.ar
# VITE_PLOTLAB_EMBED_ORIGIN=https://www.plotcenterlab.com.ar
