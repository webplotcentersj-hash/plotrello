{
  "crons": [],
  "functions": {
    "api/plotai/chat-public.ts": { "maxDuration": 60 },
    "api/plotai/design-studio.ts": { "maxDuration": 120 },
    "api/plotai/generate-image.ts": { "maxDuration": 120 },
    "api/plotai/generate-video.ts": { "maxDuration": 300 },
    "api/plotai/reloj-tablet-identificar.ts": { "maxDuration": 60 },
    "api/plotai/reloj-tablet-precalentar.ts": { "maxDuration": 60 },
    "api/plotai/reloj-tablet-marcar-auto.ts": { "maxDuration": 60 },
    "api/plotai/reloj-tablet-marcar.ts": { "maxDuration": 30 },
    "api/plotai/reloj-tablet-empleados.ts": { "maxDuration": 15 },
    "api/plotai/reloj-tablet-verificar.ts": { "maxDuration": 30 },
    "api/plotai/reloj-tablet-detectar.ts": { "maxDuration": 25 },
    "api/rrhh/reloj-tablet-marcaciones.ts": { "maxDuration": 20 },
    "api/erp/afip-autorizar.ts": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/@afipsdk/afip.js/**,node_modules/axios/**,node_modules/follow-redirects/**,node_modules/form-data/**,node_modules/combined-stream/**,node_modules/asynckit/**,node_modules/mime-types/**,node_modules/mime-db/**,node_modules/proxy-from-env/**,node_modules/https-proxy-agent/**,node_modules/agent-base/**,node_modules/debug/**,node_modules/ms/**}"
    },
    "api/erp/afip-test.ts": {
      "maxDuration": 30,
      "includeFiles": "{node_modules/@afipsdk/afip.js/**,node_modules/axios/**,node_modules/follow-redirects/**,node_modules/form-data/**,node_modules/combined-stream/**,node_modules/asynckit/**,node_modules/mime-types/**,node_modules/mime-db/**,node_modules/proxy-from-env/**,node_modules/https-proxy-agent/**,node_modules/agent-base/**,node_modules/debug/**,node_modules/ms/**}"
    },
    "api/erp/clasificacion-ia.ts": { "maxDuration": 60 }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/tablet-firma",
      "destination": "/tablet-firma.html"
    },
    {
      "source": "/tablet-firma/(.*)",
      "destination": "/tablet-firma.html"
    },
    {
      "source": "/tablet-reloj",
      "destination": "/tablet-reloj.html"
    },
    {
      "source": "/tablet-reloj/(.*)",
      "destination": "/tablet-reloj.html"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://plotcenter.com.ar https://www.plotcenter.com.ar https://plotcenterlab.com.ar https://www.plotcenterlab.com.ar"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/((?!embed/|tablet-reloj|totem|escanear-op).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/models/plotai-robot.glb",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/tablet-reloj(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=*, microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/tablet-reloj.html",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=*, microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/totem(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=*, microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/escanear-op",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=*, microphone=(), geolocation=()"
        }
      ]
    }
  ]
}

