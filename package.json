{
  "name": "7",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.config.ts --open /admin.html",
    "dev:tablet-firma": "vite --config vite.config.ts --open /tablet-firma.html",
    "build": "tsc && vite build",
    "build:admin": "tsc && vite build --mode admin",
    "build:tablet-firma": "tsc && vite build --mode tablet-firma",
    "preview": "vite preview",
    "preview:admin": "vite preview --open /admin.html",
    "preview:tablet-firma": "vite preview --open /tablet-firma.html",
    "clear-cache": "node scripts/clear-cache.js",
    "clean": "node scripts/clear-cache.js && npm run build",
    "clean-all": "node scripts/clear-cache.js --clean-node && npm run build"
  },
  "devDependencies": {
    "@types/html2canvas": "^0.5.35",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.2.0"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@google/generative-ai": "^0.24.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/node": "^5.3.14",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "marked": "^17.0.0",
    "qrcode": "^1.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.4.1",
    "xlsx": "^0.18.5"
  }
}
